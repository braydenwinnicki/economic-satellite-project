# =========================
# Data (do not commit)
# =========================
# Note: patterns below only cover the HEAVY subdirs (the image caches / weights).
# Source & processed CSVs (data/raw/*.csv, data/processed/*.csv) plus results/
# and experiment_logs/ are intentionally KEPT tracked for reproducibility.

**/raw/images/
**/processed/images/
**/data/cache/
**/data/figures/
**/data/models/

# Large ML datasets / images
*.pt
*.pth
*.npy
*.npz
*.h5
*.hdf5
*.png
*.jpg
*.jpeg
# =========================
# Model checkpoints
# =========================

checkpoints/


# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/


# =========================
# Jupyter
# =========================

.ipynb_checkpoints/


# =========================
# macOS
# =========================

.DS_Store


# =========================
# IDE
# =========================

.vscode/
.idea/


# =========================
# Logs / experiments
# =========================

*.log
runs/
wandb/
tensorboard/


# =========================
# Temporary files
# =========================

*.tmp
*.temp
*.swp
